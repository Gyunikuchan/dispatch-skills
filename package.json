{
  "name": "dispatch-skills",
  "version": "0.8.6",
  "description": "Dispatch turns the host agent into an end-to-end orchestrator across native subagents and cross-platform CLI delegates—catching flawed assumptions early and verifying delivery with minimal routine human coordination.",
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "Gyunikuchan",
    "url": "https://github.com/Gyunikuchan"
  },
  "homepage": "https://github.com/Gyunikuchan/dispatch-skills#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gyunikuchan/dispatch-skills.git"
  },
  "bugs": {
    "url": "https://github.com/Gyunikuchan/dispatch-skills/issues"
  },
  "keywords": [
    "ai",
    "agent-skills",
    "coding-agents",
    "orchestration",
    "subagents",
    "multi-agent",
    "delegation",
    "claude-code",
    "antigravity",
    "github-copilot",
    "opencode",
    "codex",
    "code-review",
    "plan-review",
    "git-worktree"
  ],
  "engines": {
    "node": "^22.18 || >=23.6"
  },
  "files": [
    "skills",
    "!skills/dispatch/config.jsonc",
    "!skills/dispatch/config.local.jsonc",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "prepare": "husky",
    "hashes": "node scripts/generate-hashes.ts",
    "maintain": "node scripts/maintain.ts && npm run hashes && npm test",
    "typecheck": "tsc -p .",
    "lint": "node scripts/lint.ts",
    "lint:all": "node scripts/lint.ts --all",
    "format": "oxfmt oxlint.config.ts \"skills/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \".agents/skills/{audit-dispatch-skills,optimise-tests,link-reader}/**/*.ts\"",
    "format:check": "npm run format -- --check",
    "test": "npm run typecheck && node scripts/maintain.ts --check && node scripts/generate-hashes.ts --check && node scripts/check-terms.ts && node scripts/validate-configs.ts && node scripts/path-bytes.ts && node --test --import=./tests/helpers/isolated-temp.ts --import=./tests/helpers/block-spawn.ts --test-reporter=./scripts/test-reporter.ts --test-concurrency=8 \"tests/{unit,integration,tooling}/**/*.test.ts\"",
    "validate:configs": "node scripts/validate-configs.ts",
    "commitlint": "commitlint --from=HEAD~1",
    "test:e2e": "node --test --import=./tests/helpers/isolated-temp.ts --import=./tests/helpers/block-spawn.ts --test-reporter=./scripts/test-reporter.ts --test-concurrency=4 \"tests/e2e/**/*.test.ts\"",
    "test:all": "npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@cloudflare/oxlint-config": "0.2.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@interfere/landmines": "0.3.1",
    "@types/node": "^22.20.5",
    "husky": "^9.1.7",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2008",
    "typescript": "^7.0.2"
  }
}
