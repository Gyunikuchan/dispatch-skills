/**
 * This file is the default configuration for the implement-dispatch agent.
 * It defines the flow policy and the platforms/models to use for plan review,
 * implementation, and code review.
 * Override by creating `config.local.jsonc` (highest precedence) or `config.jsonc` beside
 * this file; a local config replaces this file wholly rather than merging into it.
 * You may find the list of available models and their capabilities below
 * claude: https://code.claude.com/docs/en/model-config
 * agy: https://antigravity.google/docs/models/
 * copilot: https://docs.github.com/en/copilot/reference/ai-models/supported-models
 * opencode: https://opencode.ai/zen/go/v1/models
 *
 * Every knob and every platform entry may key its value by level (low, medium, high,
 * xhigh, max). Levels need not all be defined: the requested level is matched exactly, else
 * the nearest level below it, else the lowest level above it. Because a level is only
 * ever rounded down to, the lowest level key you define is the floor for every level
 * beneath it — define `low` to set the base and a higher key to mark the boundary
 * where the spend increases.
 *
 * Review-section knobs:
 *   maxRounds   — cap on total fan-out waves for the phase, counting the first review.
 *   targetCount — how many review candidates a wave dispatches to when unpinned; a whole
 *                 number or "all". The orchestrator's own platform is always eligible to
 *                 fulfil targetCount, but is sorted last so external reviewers are preferred.
 *                 Pinned runs dispatch to every live pin instead, ignoring this knob.
 *   consensus   — when true, no finding may be dismissed without counter-evidence.
 *
 * Either `maxRounds: 0` or `targetCount: 0` skips the phase entirely. When
 * `targetCount: 0`, the resolver normalizes `maxRounds` to `0` so `maxRounds === 0`
 * is the single sentinel: a phase is off when 0, providers merely unavailable when
 * `> 0` with an empty targets list.
 *
 * `platforms` holds the per-platform model/effort settings; its key order is the
 * priority order candidates are selected in. Each platform entry can be a single
 * model/effort object or an array of objects to run multiple candidates on that platform
 * (e.g. OpenCode running both a remote model and a local LLM). Flat model/effort keys
 * alongside level keys act as defaults the matched level overrides.
 *
 * Accepted effort values are CLI-specific: Antigravity takes low/medium/high;
 * Claude Code adds xhigh; OpenCode receives the value as `--variant`. An effort a
 * CLI does not recognize is that CLI's error, not this config's.
 */
{
  "plan-review": {
    "maxRounds": {
      "low": 0,
      "medium": 2,
      "high": 3,
      "max": 5,
    },
    "targetCount": {
      "low": 0,
      "medium": 1,
      "high": 2,
      "xhigh": 3,
      "max": "all",
    },
    "consensus": {
      "low": false,
      "medium": true,
    },
    "platforms": {
      "claude": {
        "low": {
          "model": "claude-opus-5",
          "effort": "low",
        },
        "max": {
          "model": "claude-fable-5.1",
          "effort": "low",
        },
      },
      "agy": {
        "low": {
          "model": "gemini-3.8-flash",
          "effort": "medium",
        },
        "max": {
          "model": "gemini-3.8-flash",
          "effort": "high",
        },
      },
      "copilot": {
        "model": "gpt-5.6-luna",
        "effort": "max",
      },
      "opencode": [
        {
          "model": "glm-5.3-flash",
          "effort": "max",
        },
        {
          "model": "deepseek-v4.1-flash",
          "effort": "max",
        },
        {
          "model": "lmstudio/qwen3.8-27b-ridge",
        },
      ],
    },
  },
  // Only native subagents can be used for implementation.
  // Implementation runs against an already-reviewed plan, so it is the cheaper half of the run:
  // spend the reasoning budget on review above, not here.
  "implementation": {
    "platforms": {
      "claude": {
        "low": {
          "model": "claude-sonnet-5",
          "effort": "medium",
        },
        "high": {
          "model": "claude-opus-5",
          "effort": "low",
        },
      },
      "agy": {
        "low": {
          "model": "gemini-3.7-flash",
          "effort": "medium",
        },
        "high": {
          "model": "gemini-3.8-flash",
          "effort": "medium",
        },
      },
      "copilot": {
        "model": "gpt-5.6-luna",
        "effort": "max",
      },
    },
  },
  "code-review": {
    "maxRounds": {
      "low": 1,
      "medium": 3,
      "max": 5,
    },
    "targetCount": {
      "low": 1,
      "high": 2,
      "xhigh": 3,
      "max": "all",
    },
    "consensus": {
      "low": false,
      "medium": true,
    },
    "platforms": {
      "claude": {
        "low": {
          "model": "claude-opus-5",
          "effort": "low",
        },
        "max": {
          "model": "claude-fable-5.1",
          "effort": "low",
        },
      },
      "agy": {
        "low": {
          "model": "gemini-3.8-flash",
          "effort": "medium",
        },
        "max": {
          "model": "gemini-3.8-flash",
          "effort": "high",
        },
      },
      "copilot": {
        "model": "gpt-5.6-luna",
        "effort": "max",
      },
      "opencode": [
        {
          "model": "glm-5.3-flash",
          "effort": "max",
        },
        {
          "model": "deepseek-v4.1-flash",
          "effort": "max",
        },
        {
          "model": "lmstudio/qwen3.8-27b-ridge",
        },
      ],
    },
  },
}
