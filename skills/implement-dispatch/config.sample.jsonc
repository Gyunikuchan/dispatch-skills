/**
 * Sample — copy to config.jsonc or config.local.jsonc beside this skill; there is no shipped
 * runtime default. Run `node scripts/resolve-flow.mjs --show-effective --platform
 * <key> --level <level>` to inspect inheritance, candidate order, reserves, and membership.
 * Overrides are whole-file replacements: config.local.jsonc, config.jsonc.
 *
 * A platform can define a base candidate plus level overrides:
 *   "claude": { "model": "claude-sonnet-5", "high": { "model": "claude-opus-5" } }
 *
 * Resolution is exact, nearest lower, otherwise lowest higher. With `{ medium: A, max: B }`:
 *   `medium` -> `medium` (exact)
 *   `high`   -> `medium` (nearest lower)
 *   `low`    -> `medium` (lowest higher)
 *
 * Review sections define `maxRounds`, `targetCount`, `consensus`, and `platforms`.
 * `maxRounds: 0` or an unpinned `targetCount: 0` disables that phase. Review platforms must be
 * standalone dispatch members; implementation platforms select native write subagents separately.
 * `targetCount` accepts a non-negative integer or "all"; selected targets precede ordered reserves.
 * Effort values are provider-defined: agy uses low/medium/high, Claude also accepts xhigh, and
 * OpenCode receives the value as `--variant`.
 *
 * Implementation entries are objects, never review-style candidate arrays. Every implementation
 * platform entry must resolve an explicit model (a string or an array of fallback model strings,
 * e.g. ["gpt-5.6-luna", "bedrock.gpt-5.6-luna"]). Defined levels follow low -> medium -> high ->
 * xhigh -> max for native-only escalation; flat entries and `max` have no escalation tier.
 * Configured fields unsupported by the host's native write launcher are disclosed and ignored
 * when comparing tiers. When multiple models are listed in an array, launchers try them in order
 * upon quota or availability failure.
 */
{
  "plan-review": {
    "maxRounds": {
      "low": 0,
      "medium": 2,
      "high": 3,
      "max": 5,
    },
    "targetCount": {
      "low": 0,
      "medium": 1,
      "high": 2,
      "xhigh": 3,
      "max": "all",
    },
    "consensus": {
      "low": false,
      "medium": true,
    },
    "platforms": {
      "claude": {
        "low": {
          "model": "claude-opus-5",
          "effort": "low",
        },
        "max": {
          "model": "claude-fable-5.1",
          "effort": "low",
        },
      },
      "agy": {
        "low": {
          "model": "gemini-3.7-flash",
          "effort": "medium",
        },
        "max": {
          "model": "gemini-3.8-flash",
          "effort": "medium",
        },
      },
      "copilot": {
        "low": {
          "model": "gpt-5.6-luna",
          "effort": "max",
        },
        "high": {
          "model": "gpt-6-astra",
          "effort": "low",
        },
        "max": {
          "model": "gpt-6-astra",
          "effort": "medium",
        },
      },
      "opencode": [
        {
          "model": "opencode-go/glm-5.3-flash",
          "effort": "max",
        },
        {
          "model": "lmstudio/qwen3.8-27b-ridge",
        },
      ],
    },
  },
  // Only native subagents can be used for implementation.
  // Implementation runs against an already-reviewed plan, so it is the cheaper half of the run:
  // spend the reasoning budget on review above, not here.
  "implementation": {
    "platforms": {
      "claude": {
        "low": {
          "model": "claude-sonnet-5",
          "effort": "medium",
        },
        "high": {
          "model": "claude-opus-5",
          "effort": "low",
        },
        "max": {
          "model": "claude-fable-5.1",
          "effort": "low",
        },
      },
      "agy": {
        "low": {
          "model": "gemini-3.7-flash",
          "effort": "medium",
        },
        "high": {
          "model": "gemini-3.8-flash",
          "effort": "medium",
        },
      },
      "copilot": {
        "model": [
          "gpt-5.6-luna",
          "bedrock.gpt-5.6-luna"
        ],
        "effort": "max",
      },
      "opencode": {
        "model": "opencode-go/glm-5.3-flash",
        "effort": "max",
      },
    },
  },
  "code-review": {
    "maxRounds": {
      "low": 1,
      "medium": 3,
      "max": 5,
    },
    "targetCount": {
      "low": 1,
      "medium": 2,
      "high": 3,
      "xhigh": 4,
      "max": "all",
    },
    "consensus": {
      "low": false,
      "medium": true,
    },
    "platforms": {
      "claude": {
        "low": {
          "model": "claude-opus-5",
          "effort": "low",
        },
        "max": {
          "model": "claude-fable-5.1",
          "effort": "low",
        },
      },
      "agy": {
        "low": {
          "model": "gemini-3.7-flash",
          "effort": "medium",
        },
        "max": {
          "model": "gemini-3.8-flash",
          "effort": "medium",
        },
      },
      "copilot": {
        "low": {
          "model": "gpt-5.6-luna",
          "effort": "max",
        },
        "high": {
          "model": "gpt-6-astra",
          "effort": "low",
        },
        "max": {
          "model": "gpt-6-astra",
          "effort": "medium",
        },
      },
      "opencode": [
        {
          "model": "opencode-go/glm-5.3-flash",
          "effort": "max",
        },
        {
          "model": "lmstudio/qwen3.8-27b-ridge",
        },
      ],
    },
  },
}