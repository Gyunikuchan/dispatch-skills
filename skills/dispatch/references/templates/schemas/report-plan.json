{
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": ["CLEAN", "FINDINGS"]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["MUST", "SHOULD", "CONSIDER"]
          },
          "locus": {
            "type": "string",
            "pattern": "^§\\s+\\S.*$"
          },
          "tag": {
            "type": "string",
            "enum": [
              "adjacent",
              "architecture",
              "compatibility",
              "correctness",
              "decomposition",
              "intent",
              "maintainability",
              "operability",
              "performance",
              "reliability",
              "security",
              "spec",
              "standards",
              "testing",
              "usability"
            ]
          },
          "defect": {
            "type": "string",
            "minLength": 1
          },
          "requiredChange": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["severity", "locus", "tag", "defect", "requiredChange"],
        "additionalProperties": false
      }
    }
  },
  "required": ["status", "findings"],
  "additionalProperties": false
}
