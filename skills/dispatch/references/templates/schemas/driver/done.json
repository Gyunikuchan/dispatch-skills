{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dispatch driver action: done",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "action",
    "stateFile",
    "guidance",
    "outcome",
    "summary"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "action": {
      "const": "done"
    },
    "stateFile": {
      "type": "string",
      "minLength": 1
    },
    "guidance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "error": {
      "type": "string"
    },
    "outcome": {
      "enum": [
        "complete",
        "skipped",
        "refused",
        "failed",
        "no-reviewable-changes",
        "lint-defects",
        "stable-failure"
      ]
    },
    "summary": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "command": {
      "type": "string"
    },
    "defects": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "checkpointed": {
      "type": "boolean"
    },
    "artifactPath": {
      "type": "string"
    },
    "ledgerPath": {
      "type": "string",
      "minLength": 1
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "checkpoint": {
          "type": [
            "object",
            "null"
          ]
        },
        "resumeCommand": {
          "type": "string",
          "minLength": 1
        },
        "ledgerPath": {
          "type": "string",
          "minLength": 1
        },
        "rulings": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "retained": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "reason"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "destinations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "warning": {
          "type": "string",
          "minLength": 1
        },
        "reviewDisabled": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
