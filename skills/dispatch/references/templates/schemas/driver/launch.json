{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dispatch driver action: launch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "action",
    "stateFile",
    "guidance",
    "argv",
    "wave"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "action": {
      "const": "launch"
    },
    "stateFile": {
      "type": "string",
      "minLength": 1
    },
    "guidance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "error": {
      "type": "string"
    },
    "argv": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "wave": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "round"
      ],
      "properties": {
        "type": {
          "enum": [
            "review",
            "rebuttal",
            "final"
          ]
        },
        "round": {
          "type": "integer"
        }
      }
    },
    "replyOnly": {
      "type": "boolean"
    },
    "slotsPath": {
      "type": "string",
      "minLength": 1
    },
    "keys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "earlyFallbacks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot", "promptPath", "outputPath", "descriptor"],
        "properties": {
          "slot": { "type": "string", "minLength": 1 },
          "promptPath": { "type": "string", "minLength": 1 },
          "outputPath": { "type": "string", "minLength": 1 },
          "descriptor": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sourceKey", "agentType", "model", "reasoningEffort", "substitutesFor"],
            "properties": {
              "sourceKey": { "type": "string", "minLength": 1 },
              "agentType": { "type": "string", "minLength": 1 },
              "model": { "type": "string", "minLength": 1 },
              "reasoningEffort": { "type": "string", "minLength": 1 },
              "substitutesFor": { "type": ["string", "null"] },
              "cascadePosition": { "type": "integer" },
              "modelCascade": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
