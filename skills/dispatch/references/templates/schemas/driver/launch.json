{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dispatch driver action: launch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "action",
    "stateFile",
    "guidance",
    "argv",
    "wave",
    "selectedTargets"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "action": {
      "const": "launch"
    },
    "stateFile": {
      "type": "string",
      "minLength": 1
    },
    "guidance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "error": {
      "type": "string"
    },
    "argv": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "wave": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "round"
      ],
      "properties": {
        "type": {
          "enum": [
            "review",
            "rebuttal",
            "final",
            "ask"
          ]
        },
        "round": {
          "type": "integer"
        }
      }
    },
    "replyOnly": {
      "type": "boolean"
    },
    "slotsPath": {
      "type": "string",
      "minLength": 1
    },
    "keys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "earlyFallbacks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot",
          "promptPath",
          "outputPath",
          "descriptor"
        ],
        "properties": {
          "slot": {
            "type": "string",
            "minLength": 1
          },
          "promptPath": {
            "type": "string",
            "minLength": 1
          },
          "outputPath": {
            "type": "string",
            "minLength": 1
          },
          "descriptor": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceKey",
              "agentType",
              "model",
              "reasoningEffort",
              "substitutesFor"
            ],
            "properties": {
              "sourceKey": {
                "type": "string",
                "minLength": 1
              },
              "agentType": {
                "type": "string",
                "minLength": 1
              },
              "model": {
                "type": "string",
                "minLength": 1
              },
              "reasoningEffort": {
                "type": "string",
                "minLength": 1
              },
              "substitutesFor": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "cascadePosition": {
                "type": "integer"
              },
              "modelCascade": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "unfulfilledTargets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wave",
        "round",
        "targets"
      ],
      "properties": {
        "wave": {
          "enum": [
            "review",
            "rebuttal",
            "final"
          ]
        },
        "round": {
          "type": "integer",
          "minimum": 1
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceKey",
              "kind"
            ],
            "properties": {
              "sourceKey": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "findingKeys": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "selectedTargets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceKey",
          "platform",
          "candidateIndex"
        ],
        "properties": {
          "sourceKey": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*:R[1-9][0-9]*:[a-z][a-z0-9-]*:[0-9]+$"
          },
          "platform": {
            "type": "string",
            "minLength": 1
          },
          "candidateIndex": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
