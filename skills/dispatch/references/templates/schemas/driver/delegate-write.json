{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dispatch driver action: delegate-write",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "action",
    "stateFile",
    "guidance",
    "fields"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "action": {
      "const": "delegate-write"
    },
    "stateFile": {
      "type": "string",
      "minLength": 1
    },
    "guidance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "error": {
      "type": "string"
    },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "launch",
        "attempt",
        "model",
        "platform",
        "cascadePosition",
        "modelCascade",
        "planPath",
        "walkthroughPath",
        "paths",
        "evidence",
        "criteria",
        "packet"
      ],
      "properties": {
        "stage": {
          "enum": [
            "tests-only",
            "production"
          ]
        },
        "launch": {
          "enum": [
            "tests-only",
            "full",
            "continuation"
          ]
        },
        "attempt": {
          "type": "integer"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "effort": {
          "type": [
            "string",
            "null"
          ]
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "cascadePosition": {
          "type": "integer"
        },
        "modelCascade": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "planPath": {
          "type": "string",
          "minLength": 1
        },
        "walkthroughPath": {
          "type": "string",
          "minLength": 1
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "outcome",
              "evidence",
              "paths",
              "commands"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^SC[1-9][0-9]*$"
              },
              "outcome": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "enum": [
                  "red",
                  "verify",
                  "review"
                ]
              },
              "paths": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "commands": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "review": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "packet": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "description": "Production brief packet written to promptPath (validated by the driver, not relayed).",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "governingOutcome",
                "settledBoundary",
                "criteria",
                "repositoryContext",
                "testsAsEvidence",
                "instruction",
                "conflict",
                "governingPlan",
                "redGate"
              ],
              "properties": {
                "governingOutcome": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "title",
                    "context"
                  ],
                  "properties": {
                    "title": {
                      "type": "string",
                      "minLength": 1
                    },
                    "context": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "settledBoundary": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "scope",
                    "nonScope",
                    "invariants",
                    "rollback"
                  ],
                  "properties": {
                    "scope": {
                      "type": "string",
                      "minLength": 1
                    },
                    "nonScope": {
                      "type": "string",
                      "minLength": 1
                    },
                    "invariants": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "rollback": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "criteria": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "outcome",
                      "evidenceClass",
                      "paths",
                      "commands",
                      "review"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^SC[1-9][0-9]*$"
                      },
                      "outcome": {
                        "type": "string",
                        "minLength": 1
                      },
                      "evidenceClass": {
                        "enum": [
                          "red",
                          "verify",
                          "review"
                        ]
                      },
                      "paths": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "commands": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "review": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    }
                  }
                },
                "repositoryContext": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "constraints",
                    "priorFailures"
                  ],
                  "properties": {
                    "constraints": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "priorFailures": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "testsAsEvidence": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "label",
                    "commands"
                  ],
                  "properties": {
                    "label": {
                      "const": "evidence, not specification"
                    },
                    "commands": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                },
                "instruction": {
                  "type": "string",
                  "minLength": 1
                },
                "conflict": {
                  "type": "string",
                  "minLength": 1
                },
                "governingPlan": {
                  "type": "string",
                  "minLength": 1
                },
                "redGate": {
                  "type": "string",
                  "minLength": 1
                },
                "reviewFindings": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "key",
                      "severity",
                      "tag",
                      "locus",
                      "defect"
                    ],
                    "properties": {
                      "key": {
                        "type": "string",
                        "minLength": 1
                      },
                      "severity": {
                        "enum": [
                          "MUST",
                          "SHOULD",
                          "CONSIDER"
                        ]
                      },
                      "tag": {
                        "type": "string",
                        "minLength": 1
                      },
                      "locus": {
                        "type": "string",
                        "minLength": 1
                      },
                      "defect": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "context": {
          "type": [
            "string",
            "object",
            "null"
          ]
        },
        "promptPath": {
          "type": "string",
          "minLength": 1
        },
        "promptHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "continuation": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "reuseChanges",
                "defects"
              ],
              "properties": {
                "kind": {
                  "const": "admission-repair"
                },
                "reuseChanges": {
                  "const": true
                },
                "defects": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "failedModel",
                "failureKind"
              ],
              "properties": {
                "kind": {
                  "const": "cascade"
                },
                "failedModel": {
                  "type": "string",
                  "minLength": 1
                },
                "failureKind": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "restore": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "baseline",
            "paths"
          ],
          "properties": {
            "baseline": {
              "type": "string",
              "minLength": 1
            },
            "paths": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "fields": {
            "properties": {
              "stage": {
                "const": "tests-only"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "fields": {
            "properties": {
              "packet": {
                "type": "null"
              },
              "criteria": {
                "items": {
                  "properties": {
                    "evidence": {
                      "const": "red"
                    }
                  }
                }
              }
            },
            "required": [
              "promptPath",
              "promptHash",
              "continuation"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "fields": {
            "properties": {
              "stage": {
                "const": "production"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "fields": {
            "properties": {
              "packet": {
                "type": "null"
              }
            },
            "required": [
              "promptPath",
              "promptHash"
            ]
          }
        }
      }
    }
  ]
}
