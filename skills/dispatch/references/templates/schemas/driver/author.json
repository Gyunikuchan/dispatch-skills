{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dispatch driver action: author",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "action",
    "stateFile",
    "guidance",
    "path",
    "template",
    "defects"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "action": {
      "const": "author"
    },
    "stateFile": {
      "type": "string",
      "minLength": 1
    },
    "guidance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "error": {
      "type": "string"
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "template": {
      "type": "string",
      "minLength": 1
    },
    "defects": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "incrementId": {
      "type": "string"
    },
    "planPath": {
      "type": "string"
    },
    "walkthroughPath": {
      "type": "string"
    },
    "unfulfilledTargets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wave",
        "round",
        "targets"
      ],
      "properties": {
        "wave": {
          "enum": [
            "review",
            "rebuttal",
            "final"
          ]
        },
        "round": {
          "type": "integer",
          "minimum": 1
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceKey",
              "kind"
            ],
            "properties": {
              "sourceKey": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
