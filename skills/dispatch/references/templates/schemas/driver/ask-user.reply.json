{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dispatch driver reply: ask-user",
  "type": "object",
  "additionalProperties": false,
  "oneOf": [
    { "required": ["answer"] },
    { "required": ["extend"] },
    { "required": ["stop"] }
  ],
  "properties": {
    "extend": { "const": true },
    "stop": { "const": true },
    "answer": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object"
        }
      ]
    }
  }
}
