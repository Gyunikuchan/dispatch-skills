{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dispatch driver action: apply-fixes",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "action",
    "stateFile",
    "guidance",
    "position",
    "clusters"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "action": {
      "const": "apply-fixes"
    },
    "stateFile": {
      "type": "string",
      "minLength": 1
    },
    "guidance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flow",
        "phase"
      ],
      "properties": {
        "flow": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "type": "string",
          "minLength": 1
        },
        "step": {
          "type": "string",
          "minLength": 1
        },
        "wave": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "round"
          ],
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1
            },
            "round": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "message"
      ],
      "properties": {
        "kind": {
          "enum": [
            "reply",
            "state",
            "fault"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "next": {
          "type": "string",
          "minLength": 1
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "state"
          }
        }
      },
      "then": {
        "required": [
          "next"
        ]
      }
    },
    "clusters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "clusterId",
          "findingIds",
          "affectedPaths",
          "verification"
        ],
        "properties": {
          "clusterId": {
            "type": "string",
            "minLength": 1
          },
          "findingIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "affectedPaths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verification": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "unfulfilledTargets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wave",
        "round",
        "targets"
      ],
      "properties": {
        "wave": {
          "enum": [
            "review",
            "rebuttal",
            "final"
          ]
        },
        "round": {
          "type": "integer",
          "minimum": 1
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceKey",
              "kind"
            ],
            "properties": {
              "sourceKey": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "findingKeys": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
