{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dispatch driver reply: delegate-write",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "envelope": {
      "type": "object"
    },
    "raw": {
      "type": "string",
      "minLength": 1
    },
    "rejected": {
      "const": true
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "failed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reason"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "envelope"
      ]
    },
    {
      "required": [
        "raw"
      ]
    },
    {
      "required": [
        "rejected",
        "reason"
      ]
    },
    {
      "required": [
        "failed"
      ]
    }
  ]
}
