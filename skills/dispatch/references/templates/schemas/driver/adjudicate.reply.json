{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dispatch driver reply: adjudicate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rulings"
  ],
  "properties": {
    "rulings": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "status",
              "severity",
              "scope",
              "locus",
              "tag",
              "defect",
              "resolution"
            ],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "accepted",
                  "rejected",
                  "downgraded",
                  "needs-user"
                ]
              },
              "severity": {
                "enum": [
                  "MUST",
                  "SHOULD",
                  "CONSIDER"
                ]
              },
              "scope": {
                "enum": [
                  "in-scope",
                  "adjacent"
                ]
              },
              "locus": {
                "type": "string",
                "minLength": 1
              },
              "tag": {
                "type": "string",
                "minLength": 1
              },
              "defect": {
                "type": "string",
                "minLength": 1
              },
              "resolution": {
                "type": "string",
                "minLength": 1
              },
              "fix": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "affectedPaths",
                  "dependsOn",
                  "verification"
                ],
                "properties": {
                  "affectedPaths": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "dependsOn": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "verification": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "empty"
            ],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "empty": {
                "const": true
              }
            }
          }
        ]
      }
    }
  }
}
