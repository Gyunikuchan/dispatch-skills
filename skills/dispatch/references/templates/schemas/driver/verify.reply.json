{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dispatch driver reply: verify",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "results"
  ],
  "properties": {
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "exit",
          "evidence"
        ],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "exit": {
            "type": "integer"
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    }
  }
}
