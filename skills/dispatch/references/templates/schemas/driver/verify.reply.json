{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dispatch driver reply: verify",
  "description": "Host-run gates (review fixes) reply with results; driver-run gates reply with nothing or, at completion, criterionEvidence.",
  "anyOf": [
    {
      "type": "null"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "criterionEvidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "criterionId",
              "evidenceClass",
              "reviewer",
              "scenario",
              "inspectedRevision",
              "observableResult",
              "limitations",
              "mutationEpoch"
            ],
            "properties": {
              "criterionId": {
                "type": "string",
                "pattern": "^SC[1-9][0-9]*$"
              },
              "evidenceClass": {
                "enum": [
                  "verify",
                  "review"
                ]
              },
              "reviewer": {
                "type": "string",
                "minLength": 1
              },
              "scenario": {
                "type": "string",
                "minLength": 1
              },
              "inspectedRevision": {
                "description": "The verify summary's scopeHash for the command carrying this criterion.",
                "type": "string",
                "minLength": 1
              },
              "observableResult": {
                "type": "string",
                "minLength": 1
              },
              "limitations": {
                "type": "string",
                "minLength": 1
              },
              "mutationEpoch": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "results"
      ],
      "properties": {
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "command",
              "exit",
              "evidence"
            ],
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1
              },
              "exit": {
                "type": "integer"
              },
              "evidence": {
                "type": "string"
              },
              "identifiers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "diagnostic": {
                "type": "string"
              },
              "scopeHash": {
                "type": "string",
                "minLength": 1
              },
              "mutationEpoch": {
                "type": "integer"
              },
              "criterionEvidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "criterionId",
                    "evidenceClass",
                    "reviewer",
                    "scenario",
                    "inspectedRevision",
                    "observableResult",
                    "limitations",
                    "mutationEpoch"
                  ],
                  "properties": {
                    "criterionId": {
                      "type": "string",
                      "pattern": "^SC[1-9][0-9]*$"
                    },
                    "evidenceClass": {
                      "enum": [
                        "verify",
                        "review"
                      ]
                    },
                    "reviewer": {
                      "type": "string",
                      "minLength": 1
                    },
                    "scenario": {
                      "type": "string",
                      "minLength": 1
                    },
                    "inspectedRevision": {
                      "description": "The verify summary's scopeHash for the command carrying this criterion.",
                      "type": "string",
                      "minLength": 1
                    },
                    "observableResult": {
                      "type": "string",
                      "minLength": 1
                    },
                    "limitations": {
                      "type": "string",
                      "minLength": 1
                    },
                    "mutationEpoch": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
