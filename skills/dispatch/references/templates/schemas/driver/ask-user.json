{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dispatch driver action: ask-user",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "action",
    "stateFile",
    "guidance",
    "question",
    "text"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "action": {
      "const": "ask-user"
    },
    "stateFile": {
      "type": "string",
      "minLength": 1
    },
    "guidance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "error": {
      "type": "string"
    },
    "question": {
      "enum": [
        "rulings",
        "opt-in",
        "inputs",
        "approval",
        "baseline-red",
        "failure-disposition",
        "implementation-recovery",
        "implementation-concerns",
        "implementation-blocked",
        "implementation-context",
        "write-scope"
      ]
    },
    "text": {
      "type": "string"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "MUST",
        "SHOULD",
        "CONSIDER"
      ],
      "properties": {
        "MUST": {
          "type": "integer",
          "minimum": 0
        },
        "SHOULD": {
          "type": "integer",
          "minimum": 0
        },
        "CONSIDER": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "options": {
      "type": "array",
      "items": {
        "enum": [
          "extend",
          "stop"
        ]
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unfulfilledTargets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wave",
        "round",
        "targets"
      ],
      "properties": {
        "wave": {
          "enum": [
            "review",
            "rebuttal",
            "final"
          ]
        },
        "round": {
          "type": "integer",
          "minimum": 1
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceKey",
              "kind"
            ],
            "properties": {
              "sourceKey": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "findingKeys": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
