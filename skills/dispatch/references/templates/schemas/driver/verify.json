{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dispatch driver action: verify",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "action",
    "stateFile",
    "guidance",
    "commands"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "action": {
      "const": "verify"
    },
    "stateFile": {
      "type": "string",
      "minLength": 1
    },
    "guidance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "error": {
      "type": "string"
    },
    "nextAction": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "type": "string",
      "minLength": 1
    },
    "incrementId": {
      "type": [
        "string",
        "null"
      ]
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "terminalEvent",
        "relocateAfterPass",
        "retain"
      ],
      "properties": {
        "terminalEvent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "result",
            "beforeRelocation"
          ],
          "properties": {
            "type": {
              "const": "integration"
            },
            "result": {
              "const": "pass"
            },
            "beforeRelocation": {
              "const": true
            }
          }
        },
        "relocateAfterPass": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "retain": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "resultsPath": {
      "type": "string",
      "minLength": 1
    },
    "substitutions": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "generators": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "purpose": {
      "enum": [
        "baseline",
        "red",
        "completion"
      ]
    },
    "scopes": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scopeHash": {
      "type": "string",
      "minLength": 1
    },
    "mutationEpoch": {
      "type": "integer"
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "evidenceClass",
          "review"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^SC[1-9][0-9]*$"
          },
          "evidenceClass": {
            "enum": [
              "red",
              "verify",
              "review"
            ]
          },
          "review": {
            "type": [
              "string",
              "null"
            ]
          },
          "commands": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
