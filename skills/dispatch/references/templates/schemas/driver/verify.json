{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dispatch driver action: verify",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "action",
    "stateFile",
    "guidance",
    "commands"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "action": {
      "const": "verify"
    },
    "stateFile": {
      "type": "string",
      "minLength": 1
    },
    "guidance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "error": {
      "type": "string"
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "purpose": {
      "enum": [
        "baseline",
        "red",
        "completion"
      ]
    },
    "scopes": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scopeHash": {
      "type": "string",
      "minLength": 1
    },
    "mutationEpoch": {
      "type": "integer"
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "evidenceClass",
          "review"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^SC[1-9][0-9]*$"
          },
          "evidenceClass": {
            "enum": [
              "red",
              "verify",
              "review"
            ]
          },
          "review": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
