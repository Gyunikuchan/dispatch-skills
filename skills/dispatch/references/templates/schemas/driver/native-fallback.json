{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dispatch driver action: native-fallback",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "action",
    "stateFile",
    "guidance",
    "position",
    "slot",
    "promptPath",
    "outputPath",
    "descriptor"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "action": {
      "const": "native-fallback"
    },
    "stateFile": {
      "type": "string",
      "minLength": 1
    },
    "guidance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flow",
        "phase"
      ],
      "properties": {
        "flow": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "type": "string",
          "minLength": 1
        },
        "step": {
          "type": "string",
          "minLength": 1
        },
        "wave": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "round"
          ],
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1
            },
            "round": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "message"
      ],
      "properties": {
        "kind": {
          "enum": [
            "reply",
            "state",
            "fault"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "next": {
          "type": "string",
          "minLength": 1
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "state"
          }
        }
      },
      "then": {
        "required": [
          "next"
        ]
      }
    },
    "slot": {
      "type": "string",
      "minLength": 1
    },
    "promptPath": {
      "type": "string",
      "minLength": 1
    },
    "outputPath": {
      "type": "string",
      "minLength": 1
    },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceKey",
        "agentType",
        "model",
        "reasoningEffort",
        "substitutesFor",
        "cascadePosition",
        "modelCascade"
      ],
      "properties": {
        "sourceKey": {
          "type": "string",
          "minLength": 1
        },
        "agentType": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "reasoningEffort": {
          "type": "string",
          "minLength": 1
        },
        "substitutesFor": {
          "type": [
            "string",
            "null"
          ]
        },
        "cascadePosition": {
          "type": "integer"
        },
        "modelCascade": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
