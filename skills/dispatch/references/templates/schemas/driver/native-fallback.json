{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dispatch driver action: native-fallback",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "action",
    "stateFile",
    "guidance",
    "slot",
    "promptPath",
    "outputPath",
    "descriptor"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "action": {
      "const": "native-fallback"
    },
    "stateFile": {
      "type": "string",
      "minLength": 1
    },
    "guidance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "error": {
      "type": "string"
    },
    "slot": {
      "type": "string",
      "minLength": 1
    },
    "promptPath": {
      "type": "string",
      "minLength": 1
    },
    "outputPath": {
      "type": "string",
      "minLength": 1
    },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceKey", "agentType", "model", "reasoningEffort", "substitutesFor"],
      "properties": {
        "sourceKey": { "type": "string", "minLength": 1 },
        "agentType": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "reasoningEffort": { "type": "string", "minLength": 1 },
        "substitutesFor": { "type": ["string", "null"] }
      }
    }
  }
}
