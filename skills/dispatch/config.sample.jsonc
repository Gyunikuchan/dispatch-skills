/**
 * Sample — copy to config.jsonc or config.local.jsonc beside this skill; there is no shipped
 * runtime default. Run `node scripts/dispatch.mjs --doctor` to inspect the selected
 * whole-file config, ordered candidates, and provider health.
 *
 * Each platform maps to one candidate or an ordered candidate array:
 *   "claude": [{ "model": "claude-opus-5", "effort": "low", "sandbox": true }]
 *
 * CLI model/effort overrides win; omitted values use provider defaults. `sandbox` is supported by
 * Claude and Copilot. Overrides are selected whole in this order: config.local.jsonc,
 * config.jsonc. Missing platforms are not cascade members.
 */
{
  "platforms": {
    "claude": {
      "model": "claude-opus-5",
      "effort": "low",
      "sandbox": true,
    },
    "agy": {
      "model": "gemini-3.7-flash",
      "effort": "medium",
    },
    "copilot": {
      "model": "gpt-6-astra",
      "effort": "low",
      "sandbox": true,
    },
    "opencode": [
      {
        "model": "opencode-go/glm-5.3-flash",
        "effort": "max",
      },
      {
        "model": "lmstudio/qwen3.8-27b-ridge",
      },
    ],
  },
}
