/**
 * Copy to config.jsonc or config.local.jsonc beside this skill. No default is shipped;
 * config.local.jsonc takes priority. Check settings with
 * `node scripts/dispatch.ts doctor run --session <session> --host <platform> [--level <level>]`.
 * `<session>` is the dispatch session folder.
 *
 * Model references:
 * - claude: https://platform.claude.com/docs/en/models/overview
 * - agy: https://antigravity.google/docs/models/
 * - copilot: https://docs.github.com/en/copilot/reference/ai-models/supported-models
 * - opencode (zen): https://opencode.ai/zen/v1/models
 * - opencode (go): https://opencode.ai/zen/go/v1/models
 * - codex: https://developers.openai.com/codex/models
 */
{
  // Optional; true writes a session diagnostics.md retrospective but incurs some token costs.
  "diagnostics": false,
  // Optional; max concurrent implementation task writers (default 1).
  "write-concurrency": 3,
  // Optional; read-only command prefixes delegates may run (e.g code-index query).
  "read-commands": ["codegraph explore"],
  // Optional; USD per 1M token overrides over references/pricing.json (key: model id or "provider/*").
  "pricing": {
    "lmstudio/*": {
      "rates": {
        "input": 0,
        "output": 0,
        "cacheRead": 0,
        "cacheWrite5m": 0,
        "cacheWrite1h": 0,
      },
    },
  },
  // Required for ask/review. Keep only providers you use; each target is one voice.
  // Hint: models with higher reasoning effort (e.g. medium+) tends to do better.
  // https://arena.liebig.gg/
  "read-delegates": {
    "claude": {
      // Optional; defaults to true for sandboxed platforms.
      "sandbox": true,
      "targets": [
        // Levels: low, medium, high, xhigh, max. Missing levels fall back to nearest lower, else lowest higher.
        // Here, xhigh uses high. Entries do not inherit fields; effort is optional.
        {
          "low": { "model": "claude-haiku-5-5", "effort": "high" },
          "medium": { "model": "claude-haiku-5-5", "effort": "xhigh" },
          "high": { "model": "claude-sonnet-5-5", "effort": "high" },
          "max": { "model": "claude-opus-5-5", "effort": "medium" },
        },
      ],
    },
    "agy": {
      "targets": [
        {
          // No effort uses the provider default. agy accepts low/medium/high.
          "low": { "model": "gemini-4-hydrogen" },
        },
      ],
    },
    // Multiple targets under one provider are separate voices, not fallback models.
    "copilot": {
      // Optional (default false); true skips the CLI and uses native subagents when running on this host.
      "nativeSubagentsOnly": true,
      "targets": [
        {
          "low": { "model": "gpt-6.1-terra", "effort": "medium" },
          "high": { "model": "gpt-6.1-sol", "effort": "medium" },
          "max": { "model": "gpt-6.1-sol", "effort": "high" },
        },
        // Model arrays try each name in order if the previous one fails.
        {
          "low": {
            "model": ["claude-sonnet-5-5", "bedrock.claude-sonnet-5-5"],
            "effort": "high",
          },
          "max": {
            "model": ["claude-opus-5-5", "bedrock.claude-opus-5-5"],
            "effort": "medium",
          },
        },
      ],
    },
    "opencode": {
      // OpenCode uses effort as the model variant (model#effort).
      "targets": [
        {
          "low": {
            "model": "opencode-go/muse-spark-1.3-contributor",
            "effort": "xhigh",
          },
        },
        {
          "low": {
            "model": "opencode-go/deepseek-v4.1-flash",
            "effort": "high",
          },
          "high": {
            "model": "opencode-go/deepseek-v4.1-flash",
            "effort": "max",
          },
        },
        {
          "low": { "model": "opencode-go/glm-5.3-flash", "effort": "high" },
          "high": { "model": "opencode-go/glm-5.3-flash", "effort": "max" },
        },
        {
          "low": {
            "model": "opencode-go/minimax-m3.1-flash",
            "effort": "xhigh",
          },
          "high": {
            "model": "opencode-go/minimax-m3.1-flash",
            "effort": "max",
          },
        },
        {
          "low": { "model": "lmstudio/qwen3.8-27b-ridge", "effort": "medium" },
        },
      ],
    },
    "codex": {
      "targets": [
        {
          "low": { "model": "gpt-6-luna", "effort": "xhigh" },
          "medium": { "model": "gpt-6-luna", "effort": "max" },
          "high": { "model": "gpt-6.1-terra", "effort": "xhigh" },
          "max": { "model": "gpt-6.1-terra", "effort": "max" },
        },
      ],
    },
  },
  // Required for each host platform; doctor blocks without it.
  // Hint: scale from fast/mid-tier coding models (low-medium) to your strongest (high-max).
  "write-subagents": {
    "claude": {
      "low": { "model": "claude-haiku-5-5", "effort": "high" },
      "medium": { "model": "claude-haiku-5-5", "effort": "xhigh" },
      "high": { "model": "claude-sonnet-5-5", "effort": "high" },
      "max": { "model": "claude-opus-5-5", "effort": "medium" },
    },
    "agy": {
      "low": { "model": "gemini-4-hydrogen", "effort": "medium" },
    },
    "copilot": {
      "low": { "model": ["gpt-6-luna", "bedrock.gpt-6-luna"], "effort": "max" },
    },
    "opencode": {
      "low": {
        "model": "opencode-go/muse-spark-1.3-contributor",
        "effort": "xhigh",
      },
      "medium": { "model": "opencode-go/deepseek-v4.1-flash", "effort": "max" },
    },
    "codex": {
      "low": { "model": "gpt-6.1-terra", "effort": "low" },
      "medium": { "model": "gpt-6.1-terra", "effort": "medium" },
      "high": { "model": "gpt-6.1-sol", "effort": "low" },
      "max": { "model": "gpt-6.1-sol", "effort": "medium" },
    },
  },
  // Required per host platform; used for explorers and routine tasks (e.g. test cleanup).
  // The context-limit (in tokens) is a soft limit that encourages nested subagents for larger explorations.
  // Hint: pick a fast, cheap model with at least medium effort.
  "utility-subagents": {
    "claude": {
      "model": "claude-haiku-5-5",
      "effort": "medium",
      "context-limit": 150000,
    },
    "agy": {
      "model": "gemini-4-hydrogen",
      "effort": "medium",
      "context-limit": 300000,
    },
    "copilot": {
      "model": "gpt-6-luna",
      "effort": "xhigh",
      "context-limit": 300000,
    },
    "opencode": {
      "model": "opencode-go/muse-spark-1.3-contributor",
      "effort": "high",
      "context-limit": 300000,
    },
    "codex": {
      "model": "gpt-6-luna",
      "effort": "xhigh",
      "context-limit": 300000,
    },
  },
  // Optional; review breadth and round caps per level (defaults to 1 target, 1 round).
  "phases": {
    // Also used for design reviews.
    "plan-review": {
      // Review voice count (or "all"); 0 disables unless pinned on CLI.
      "targets": { "low": 0, "medium": 1, "high": 2, "xhigh": 3, "max": "all" },
      // Max review rounds; 0 disables this level.
      "rounds": { "low": 0, "medium": 2, "high": 3, "max": 5 },
      // Optional: use only these providers (and all their targets).
      "only": ["claude", "agy", "copilot"],
    },
    "code-review": {
      "targets": { "low": 1, "medium": 2, "high": 3, "xhigh": 4, "max": "all" },
      "rounds": { "low": 1, "medium": 3, "max": 5 },
    },
  },
}
