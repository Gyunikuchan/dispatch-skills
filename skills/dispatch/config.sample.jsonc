/**
 * Copy to config.jsonc or config.local.jsonc beside this skill. No default is shipped;
 * config.local.jsonc takes priority. Check settings with
 * `node scripts/dispatch.ts doctor run --session <session> [--level <level>]`.
 * `<session>` is the dispatch session folder.
 *
 * Model references:
 * - claude: https://platform.claude.com/docs/en/models/overview
 * - agy: https://antigravity.google/docs/models/
 * - copilot: https://docs.github.com/en/copilot/reference/ai-models/supported-models
 * - opencode (zen): https://opencode.ai/zen/v1/models
 * - opencode (go): https://opencode.ai/zen/go/v1/models
 * - codex: https://developers.openai.com/codex/models
 */
{
  // Optional; true adds one retro turn per run and writes the session diagnostics.md
  // retrospective; false adds nothing. Changes take effect at the next mutating send.
  "diagnostics": false,
  // Optional; maximum concurrent implementation task writers (default 1).
  "write-concurrency": 3,
  // Optional; host read-command prefixes that read delegates may run, such as a code-index query.
  // Name the read subcommand: a bare tool name also permits its write subcommands. List only
  // commands that write at most their own cache; Claude's sandbox permits working-directory writes.
  // Create or refresh any index these commands query before delegates launch.
  "read-commands": ["codegraph explore"],
  // Required for asks and reviews. Keep only providers you use.
  // Each target is a separate review voice (provider[index]).
  "read-delegates": {
    "claude": {
      // Optional; defaults to true for sandboxed platforms.
      "sandbox": true,
      "targets": [
        // Set only the levels you need: low, medium, high, xhigh, max.
        // Missing level? Use the nearest lower, or the lowest higher.
        // Here, medium uses low; xhigh and max use high. Entries do not inherit fields.
        // Effort is optional; CLI model/effort overrides win.
        {
          "low": { "model": "claude-sonnet-5-5", "effort": "high" },
          "high": { "model": "claude-opus-5-5", "effort": "medium" },
        },
      ],
    },
    "agy": {
      "targets": [
        {
          "low": { "model": "gemini-3.8-flash", "effort": "medium" },
          // No effort uses the provider default. agy accepts low/medium/high.
          "high": { "model": "gemini-3.8-flash" },
        },
      ],
    },
    // Multiple targets under one provider are separate voices, not fallback models.
    "copilot": {
      // Optional; defaults to false. true never runs this provider's CLI: when the orchestrator
      // is this platform, its native subagents serve these targets alongside the CLI wave;
      // otherwise the targets are skipped.
      "nativeSubagentsOnly": true,
      "targets": [
        {
          "low": { "model": "gpt-6.1-terra", "effort": "medium" },
          "high": { "model": "gpt-6.1-sol", "effort": "medium" },
          "max": { "model": "gpt-6.1-sol", "effort": "high" },
        },
        // Model arrays try each name in order if the previous one fails.
        {
          "low": { "model": ["gpt-6.1-sol", "bedrock.gpt-6.1-sol"], "effort": "medium" },
          "max": { "model": ["gpt-6.1-sol", "bedrock.gpt-6.1-sol"], "effort": "high" },
        },
      ],
    },
    "opencode": {
      // OpenCode uses effort as the model variant (model#effort).
      "targets": [
        { "low": { "model": "opencode-go/muse-spark-1.3-contributor", "effort": "xhigh" } },
        { "low": { "model": "lmstudio/qwen3.8-27b-ridge", "effort": "medium" } },
      ],
    },
    "codex": {
      "targets": [
        {
          "low": { "model": "gpt-6.1-terra", "effort": "medium" },
          "high": { "model": "gpt-6.1-sol", "effort": "medium" },
        },
      ],
    },
  },
  // Optional: implementation models used by your host, separate from review targets.
  // Add your host here to use the implement flow.
  "write-subagents": {
    "claude": {
      "low": { "model": "claude-haiku-5-5", "effort": "high" },
      "medium": { "model": "claude-sonnet-5-5", "effort": "medium" },
      "high": { "model": "claude-sonnet-5-5", "effort": "high" },
      "max": { "model": "claude-opus-5-5", "effort": "medium" },
    },
    "agy": {
      "low": { "model": "gemini-3.8-flash", "effort": "medium" },
    },
    "copilot": {
      "low": { "model": ["gpt-6-luna", "bedrock.gpt-6-luna"], "effort": "max" },
    },
    "opencode": {
      "low": { "model": "opencode-go/muse-spark-1.3-contributor", "effort": "xhigh" },
    },
    "codex": {
      "low": { "model": "gpt-6-luna", "effort": "max" },
      "medium": { "model": "gpt-6.1-terra", "effort": "medium" },
      "high": { "model": "gpt-6.1-terra", "effort": "high" },
      "max": { "model": "gpt-6.1-sol", "effort": "medium" },
    },
  },
  // Optional: native read-only explorers for grounding and research; one entry per platform.
  "explore-subagents": {
    "claude": { "model": "claude-haiku-5-5", "effort": "medium" },
    "agy": { "model": "gemini-3.8-flash", "effort": "medium" },
    "copilot": { "model": "gpt-6-luna", "effort": "xhigh" },
    "opencode": { "model": "opencode-go/muse-spark-1.3-contributor", "effort": "medium" },
    "codex": { "model": "gpt-6-luna", "effort": "xhigh" },
  },
  // Optional: set review size and rounds by level.
  // Without a phase policy, standalone reviews use one target and one round.
  "phases": {
    // Also used for design reviews.
    "plan-review": {
      // Number of review voices (not providers); "all" uses every eligible target.
      // 0 disables this level unless targets are pinned on the CLI.
      "targets": { "low": 0, "medium": 1, "high": 2, "xhigh": 3, "max": "all" },
      // Max review rounds; 0 disables this level.
      "rounds": { "low": 0, "medium": 2, "high": 3, "max": 5 },
      // Optional: use only these providers (and all their targets).
      "only": ["claude", "agy", "copilot"],
    },
    "code-review": {
      "targets": { "low": 1, "medium": 2, "high": 3, "xhigh": 4, "max": "all" },
      "rounds": { "low": 1, "medium": 3, "max": 5 },
    },
  },
}
