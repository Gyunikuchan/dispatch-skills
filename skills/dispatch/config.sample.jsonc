/**
 * Sample — copy to config.jsonc or config.local.jsonc beside this skill; there is no shipped
 * runtime default. Overrides are whole-file replacements: config.local.jsonc, then config.jsonc.
 * Run `node scripts/dispatch.mjs --doctor --level <level>` to inspect the selected config,
 * resolved targets, phase policy, write subagents, and provider health.
 *
 * Three tables:
 * - "read-delegates" (required): the one target table for asks and every review. Each provider
 *   maps to `{ "sandbox"?: boolean, "targets": [levelMap, ...] }`. Every target is an independent
 *   dispatch target identified as `provider[index]`; phase `targets` counts, `"all"`, reserves, and
 *   consensus count targets, not providers. Missing providers are not cascade members.
 * - "write-subagents" (optional): native write subagents, selected by the host platform; never
 *   dispatched. Each entry is one level map. A missing entry fails the implement flow.
 * - "phases" (optional): review policy for plan-review and code-review. Design reviews share the
 *   plan-review policy while retaining their own review identity. Each configured phase needs
 *   `targets` (non-negative integer or "all"), `rounds`, and `consensus` level maps, plus an
 *   optional `only` provider list (it includes every target beneath each provider). An absent
 *   policy leaves both plan and design reviews unconfigured; standalone reviews use one target
 *   for one round with host-final rulings.
 *
 * A level map keys any non-empty subset of low, medium, high, xhigh, max to
 * `{ "model": string | string[], "effort"?: string }`. Resolution is exact, nearest lower,
 * otherwise lowest higher, and the selected level is used as-is: no field inheritance. With
 * `{ medium: A, max: B }`: `high` -> A (nearest lower), `low` -> A (lowest higher).
 * A `model` array is an alias cascade tried in order within one target on any failure; duplicate
 * aliases and structurally identical targets are rejected. Omit `effort` for models that reject
 * effort options: no effort flag is passed and the provider default applies. Effort values are
 * provider-defined: agy uses low/medium/high, Claude also accepts xhigh, and OpenCode receives the
 * value as the model variant (`model#effort`). CLI model/effort overrides win.
 * `rounds: 0` or an unpinned `targets: 0` disables that phase at that level.
 *
 * Sandbox is provider-wide (claude, copilot, opencode; never agy) and defaults to true; false opts
 * out. Claude and Copilot use their CLI sandbox; OpenCode uses Linux Bubblewrap. When isolation is
 * unavailable, the run proceeds unsandboxed with a warning on stderr and `sandboxDowngraded` in
 * structured output.
 */
{
  "read-delegates": {
    "claude": {
      "sandbox": true,
      "targets": [
        {
          "low": { "model": "claude-opus-5-5", "effort": "low" },
          "max": { "model": "claude-fable-5-1", "effort": "low" },
        },
      ],
    },
    "agy": {
      "targets": [
        {
          "low": { "model": "gemini-3.7-flash", "effort": "medium" },
          // No effort: the provider default applies.
          "high": { "model": "gemini-3.8-flash" },
        },
      ],
    },
    // Two copilot targets: two independent review voices under one provider.
    "copilot": {
      "sandbox": true,
      "targets": [
        {
          "low": { "model": "gpt-5.6-luna", "effort": "max" },
          "high": { "model": "gpt-6-astra", "effort": "low" },
          "max": { "model": "gpt-6-astra", "effort": "medium" },
        },
        {
          "low": { "model": ["gpt-5.6-sol", "bedrock.gpt-5.6-sol"], "effort": "medium" },
          "max": { "model": ["gpt-5.6-sol", "bedrock.gpt-5.6-sol"], "effort": "high" },
        },
      ],
    },
    "opencode": {
      "targets": [
        { "low": { "model": "opencode-go/glm-5.3-flash", "effort": "max" } },
        { "low": { "model": "lmstudio/qwen3.8-27b-ridge", "effort": "medium" } },
      ],
    },
  },
  // Implementation runs against an already-reviewed plan, so it is the cheaper half of the run:
  // spend the reasoning budget on review, not here.
  "write-subagents": {
    "claude": {
      "low": { "model": "claude-sonnet-5", "effort": "medium" },
      "high": { "model": "claude-opus-5-5", "effort": "low" },
      "max": { "model": "claude-fable-5-1", "effort": "low" },
    },
    "agy": {
      "low": { "model": "gemini-3.7-flash", "effort": "medium" },
      "high": { "model": "gemini-3.8-flash" },
    },
    "copilot": {
      "low": { "model": ["gpt-5.6-luna", "bedrock.gpt-5.6-luna"], "effort": "max" },
    },
    "opencode": {
      "low": { "model": "opencode-go/glm-5.3-flash", "effort": "max" },
    },
  },
  "phases": {
    "plan-review": {
      "targets": { "low": 0, "medium": 1, "high": 2, "xhigh": 3, "max": "all" },
      "rounds": { "low": 0, "medium": 2, "high": 3, "max": 5 },
      "consensus": { "low": false, "medium": true },
      // Shared with design review.
      "only": ["claude", "agy", "copilot"],
    },
    "code-review": {
      "targets": { "low": 1, "medium": 2, "high": 3, "xhigh": 4, "max": "all" },
      "rounds": { "low": 1, "medium": 3, "max": 5 },
      "consensus": { "low": false, "medium": true },
    },
  },
}
