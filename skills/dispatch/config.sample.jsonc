/**
 * Copy to config.jsonc or config.local.jsonc beside this skill. No default is shipped;
 * config.local.jsonc takes priority. Check settings with
 * `node scripts/dispatch.mjs --doctor --level <level>`.
 *
 * Model references:
 * - claude: https://platform.claude.com/docs/en/models/overview
 * - agy: https://antigravity.google/docs/models/
 * - copilot: https://docs.github.com/en/copilot/reference/ai-models/supported-models
 * - opencode (zen): https://opencode.ai/zen/v1/models
 * - opencode (go): https://opencode.ai/zen/go/v1/models
 */
{
  // Required for asks and reviews. Keep only providers you use.
  // Each target is a separate review voice (provider[index]).
  "read-delegates": {
    "claude": {
      // Optional for Claude, Copilot, OpenCode; defaults to true. False opts out.
      // If unavailable, dispatch warns and runs without a sandbox.
      "sandbox": true,
      "targets": [
        // Set only the levels you need: low, medium, high, xhigh, max.
        // Missing level? Use the nearest lower, or the lowest higher.
        // Here, medium through xhigh use low. Entries do not inherit fields.
        // Effort is optional; CLI model/effort overrides win.
        {
          "low": { "model": "claude-opus-5-5", "effort": "low" },
          "max": { "model": "claude-fable-5-1", "effort": "low" },
        },
      ],
    },
    "agy": {
      "targets": [
        {
          "low": { "model": "gemini-3.7-flash", "effort": "medium" },
          // No effort uses the provider default. agy accepts low/medium/high.
          "high": { "model": "gemini-3.8-flash" },
        },
      ],
    },
    // Multiple targets under one provider are separate voices, not fallback models.
    "copilot": {
      "sandbox": true,
      "targets": [
        {
          "low": { "model": "gpt-5.6-luna", "effort": "max" },
          "high": { "model": "gpt-6-astra", "effort": "low" },
          "max": { "model": "gpt-6-astra", "effort": "medium" },
        },
        // Model arrays try each name in order if the previous one fails.
        {
          "low": { "model": ["gpt-5.6-sol", "bedrock.gpt-5.6-sol"], "effort": "medium" },
          "max": { "model": ["gpt-5.6-sol", "bedrock.gpt-5.6-sol"], "effort": "high" },
        },
      ],
    },
    "opencode": {
      // OpenCode uses effort as the model variant (model#effort).
      "targets": [
        { "low": { "model": "opencode-go/glm-5.3-flash", "effort": "max" } },
        { "low": { "model": "lmstudio/qwen3.8-27b-ridge", "effort": "medium" } },
      ],
    },
  },
  // Optional: implementation models used by your host, separate from review targets.
  // Add your host here to use the implement flow.
  "write-subagents": {
    "claude": {
      "low": { "model": "claude-sonnet-5", "effort": "medium" },
      "high": { "model": "claude-opus-5-5", "effort": "low" },
      "max": { "model": "claude-fable-5-1", "effort": "low" },
    },
    "agy": {
      "low": { "model": "gemini-3.7-flash", "effort": "medium" },
      "high": { "model": "gemini-3.8-flash" },
    },
    "copilot": {
      "low": { "model": ["gpt-5.6-luna", "bedrock.gpt-5.6-luna"], "effort": "max" },
    },
    "opencode": {
      "low": { "model": "opencode-go/glm-5.3-flash", "effort": "max" },
    },
  },
  // Optional: set review size, rounds, and consensus by level.
  // Without a phase policy, standalone reviews use one target and one round.
  "phases": {
    // Also used for design reviews.
    "plan-review": {
      // Number of review voices (not providers); "all" uses every eligible target.
      // 0 disables this level unless targets are pinned on the CLI.
      "targets": { "low": 0, "medium": 1, "high": 2, "xhigh": 3, "max": "all" },
      // Max review rounds; 0 disables this level.
      "rounds": { "low": 0, "medium": 2, "high": 3, "max": 5 },
      // Require agreement between voices? False leaves the final call to the host.
      "consensus": { "low": false, "medium": true },
      // Optional: use only these providers (all their targets).
      "only": ["claude", "agy", "copilot"],
    },
    "code-review": {
      "targets": { "low": 1, "medium": 2, "high": 3, "xhigh": 4, "max": "all" },
      "rounds": { "low": 1, "medium": 3, "max": 5 },
      "consensus": { "low": false, "medium": true },
    },
  },
}
