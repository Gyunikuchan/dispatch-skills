/**
 * Default configuration for the dispatch cascade: per-platform model/effort and cascade
 * order/membership. This is the single source of truth for dispatch's defaults — no
 * model/effort default lives in the runner scripts themselves.
 *
 * Schema: { "platforms": { "<key>": { "model"?: string | string[], "effort"?: string } | Array<{ "model"?: string | string[], "effort"?: string }> } }
 *   - Key order of "platforms" is the cascade order.
 *   - A platform key absent from the loaded config is never dispatched to.
 *   - Each platform entry can be a single model/effort object or an array of candidate
 *     objects (e.g. Claude falling back across models, OpenCode cascading across remote models and a local LLM).
 *   - "model" within any candidate object can be a single string or an array of strings.
 *   - An entry omitting "model" / "effort" passes no `-m` / `-e`, so the provider CLI's
 *     own default applies.
 *
 * Precedence: CLI `-m` / `-e` flags > this config's per-platform values > provider CLI's
 * own default.
 *
 * Override locations (loaded wholly — first match wins, no merging across tiers):
 *   1. <skill-root>/config.local.jsonc
 *   2. <skill-root>/config.jsonc
 *   3. <skill-root>/config.default.jsonc (this file)
 *
 * `--no-config` on dispatch.mjs ignores this file entirely (model, effort, and cascade
 * membership) and requires `--provider` — there is no cascade without a config.
 */
{
  "platforms": {
    "claude": {
      "model": "claude-opus-5",
      "effort": "low",
    },
    "agy": {
      "model": "gemini-3.8-flash",
      "effort": "medium",
    },
    "copilot": {
      "model": "gpt-5.6-luna",
      "effort": "max",
    },
    "opencode": [
      {
        "model": "opencode-go/glm-5.3-flash",
        "effort": "max",
      },
      {
        "model": "opencode-go/deepseek-v4.1-flash",
        "effort": "max",
      },
      {
        "model": "lmstudio/qwen3.8-27b-ridge",
      },
    ],
  },
}
