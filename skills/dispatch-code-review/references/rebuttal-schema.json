{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["responses"],
  "properties": {
    "responses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "key", "verdict", "evidence"],
        "properties": {
          "type": { "const": "rebuttal" },
          "key": { "type": "string", "minLength": 1 },
          "verdict": { "enum": ["CONFIRM", "REBUT", "INTENT-DISPUTE"] },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
