{
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": ["CLEAN", "FINDINGS"]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["MUST", "SHOULD", "CONSIDER"]
          },
          "locus": {
            "type": "string",
            "pattern": "^§\\s+\\S.*$"
          },
          "tag": {
            "type": "string",
            "enum": [
              "adjacent",
              "approach",
              "architecture",
              "auth",
              "blast-radius",
              "coherence",
              "compatibility",
              "correctness",
              "domain-logic",
              "edge-case",
              "intent",
              "invariant",
              "migration",
              "partial-failure",
              "perf",
              "race",
              "rollback",
              "scope-creep",
              "security",
              "simplicity",
              "spec-gap",
              "standards",
              "state-machine",
              "testability",
              "user-gap",
              "validation",
              "verification",
              "yagni"
            ]
          },
          "defect": {
            "type": "string",
            "minLength": 1
          },
          "requiredChange": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["severity", "locus", "tag", "defect", "requiredChange"],
        "additionalProperties": false
      }
    }
  },
  "required": ["status", "findings"],
  "additionalProperties": false
}
