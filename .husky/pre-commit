#!/bin/sh

# Re-generate skill-hashes.json when skill files change.

SKILL_PATTERN='dispatch.*/SKILL\.md\|skills/dispatch/references/\|skills/dispatch/scripts/'

if git diff --cached --name-only | grep -q "$SKILL_PATTERN"; then
  node scripts/generate-hashes.mjs

  # Stage the updated manifest so it's included in the commit.
  git add skills/dispatch/skill-hashes.json
fi
