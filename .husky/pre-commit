#!/bin/sh
set -e

# Re-generate skill-hashes.json when skill files change.

# Hashed skills: dispatch only — it ships the one skill-hashes.json manifest (nested
# references/ included). Generated by scripts/generate-hashes.ts.
# ERE (grep -E): `\|` and `\?` in a basic-regex pattern are GNU extensions that degrade to
# literals on BSD/BusyBox grep, silently skipping regeneration.
SKILL_PATTERN='skills/dispatch/(SKILL\.md|references/|scripts/)'

if git diff --cached --name-only | grep -qE "$SKILL_PATTERN"; then
  node scripts/generate-hashes.ts

  # Stage the updated manifest so it's included in the commit.
  git add skills/dispatch/skill-hashes.json
fi

# Validate all found dispatch config files.
node scripts/validate-configs.ts

# Type-check shipped and tooling scripts (tsconfig.json: strict, noEmit).
npx --no-install tsc -p .
