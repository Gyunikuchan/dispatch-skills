/**
  * This file is the default configuration for the implement-dispatch agent.
  * It defines the platforms and models to use for plan review, implementation, and code review.
  * You can override this configuration by creating a config.jsonc file in your local environment.
  * You may find the list of available models and their capabilities below
  * claude: https://code.claude.com/docs/en/model-config
  * agy: https://antigravity.google/docs/models/
  * copilot: https://docs.github.com/en/copilot/reference/ai-models/supported-models
*/
{
  // Ordered list of platforms to use for plan review
  "plan-review": {
    "claude": {
      "model": "claude-opus-5",
      "effort": "medium",
    },
    "agy": {
      "model": "gemini-3.8-flash",
      "effort": "medium",
    },
    "copilot": {
      "model": "gpt-5.6-luna",
      "effort": "max",
    },
    "local": {
      "model": "lmstudio/qwen3.8-27b-ridge",
    }
  },
  // Only native subagents can be used for implementation
  "implementation": {
    "claude": {
      "model": "claude-opus-5",
      "effort": "medium",
    },
    "agy": {
      "model": "gemini-3.8-flash",
      "effort": "medium",
    },
    "copilot": {
      "model": "gpt-5.6-luna",
      "effort": "max",
    }
  },
  // Ordered list of platforms to use for code review
  "code-review": {
    "claude": {
      "model": "claude-opus-5",
      "effort": "medium",
    },
    "agy": {
      "model": "gemini-3.8-flash",
      "effort": "medium",
    },
    "copilot": {
      "model": "gpt-5.6-luna",
      "effort": "max",
    },
    "local": {
      "model": "lmstudio/qwen3.8-27b-ridge",
    }
  }
}