{
  "units": [
    "tests/unit/policy",
    "tests/unit/providers",
    "tests/unit/lib",
    "tests/unit/toolkit",
    "tests/integration",
    "tests/tooling",
    "tests/e2e"
  ],
  "packetLineBudget": 2500,
  "slowTestMs": 100,
  "maxParallelWriters": 4,
  "coverageInclude": ["skills/**/*.ts", "scripts/**/*.ts", ".agents/skills/**/scripts/**"],
  "excludeFromWriters": ["tests/helpers/**", "tests/fixtures/**", "tests/unit/*/fixtures/**"]
}
